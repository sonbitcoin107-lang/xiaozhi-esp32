{
    "type": "bread-compact-wifi-lcd",
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi-lcd",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X320=y"
            ]
        },
        {
            "name": "robotweb-cloud",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X320=y",
                "CONFIG_OTA_URL=\"https://robot.minhtilab.com/ota/\""
            ]
        }
    ]
}
